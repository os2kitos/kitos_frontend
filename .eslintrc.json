{
  "root": true,
  "ignorePatterns": ["projects/**/*", "src/app/api/**"],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ],
        "@angular-eslint/prefer-inject": ["off"],
        "@angular-eslint/use-lifecycle-interface": ["off"]
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {
        "@angular-eslint/template/no-negated-async": ["off"]
      }
    },
    {
      "files": ["cypress/**/*.cy.ts", "src/app/component-tests/**/*.cy.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.property.name=/^(only|skip)$/][callee.object.name=/^(it|describe|context)$/]",
            "message": "Do not commit focused (.only) or skipped (.skip) Cypress tests."
          }
        ]
      }
    },
    {
      "files": ["cypress/**/*.ts", "src/app/component-tests/**/*.ts"],
      "rules": {
        // Chai/Cypress assertions such as `expect(x).to.be.true` are property-access
        // getters, not function calls, so they trip this rule despite being correct.
        "@typescript-eslint/no-unused-expressions": "off",
        // Augmenting the global Cypress namespace for custom command typings is the
        // documented Cypress pattern and can't be expressed as an ES module.
        "@typescript-eslint/no-namespace": "off",
        // Cypress custom command signatures (Chainable<Subject = any>, etc.) rely on `any`.
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["*.ts"],
      "extends": ["plugin:@ngrx/all"],
      "rules": {
        "@ngrx/avoid-mapping-selectors": ["off"],
        "@ngrx/no-store-subscription": ["off"],
        "@ngrx/avoid-dispatching-multiple-actions-sequentially": ["off"],
        "@angular-eslint/prefer-standalone": ["off"],
        "@ngrx/on-function-explicit-return-type": ["off"]
      }
    }
  ]
}
